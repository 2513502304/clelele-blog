---
import ChristmasHat from '@components/christmas/ChristmasHat.astro';
import { SiteProfileView } from '@components/site-profile/SiteProfileView';
import type { HomeSiderType } from '@constants/enum';
import { RESERVED_ROUTES } from '@constants/router';
import { christmasConfig, configuredSeriesSlugs, enabledSeriesSlugs, routers } from '@constants/site-config';
import { getAllTags, getCategoryList, getPostCount, getSortedPosts } from '@lib/content';
import { publicSiteProfile } from '@lib/site-profile/public';
import { cn, filterNavItems } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import { getLocaleFromUrl, localizedPath, resolveNavName, stripLocaleFromPath, t } from '@/i18n';
import type { BlogSchema } from '@/types/blog';
import '@/styles/home-info.css';

const profile = await publicSiteProfile();

interface Props {
  type?: HomeSiderType;
  className?: string;
  isDrawer?: boolean;
  frontmatter?: BlogSchema;
}

const locale = getLocaleFromUrl(Astro.url.pathname);
const postCount = await getPostCount(locale);
const { countMap } = await getCategoryList(locale);
const posts = await getSortedPosts(locale);
const tags = getAllTags(posts);

const allTags = Object.entries(tags).map(([tag, count]) => ({ tag, count }));

// 生成唯一 ID 前缀
const uniqueId = `home-info-${Math.random().toString(36).substring(2, 11)}`;
const { className } = Astro.props;

// Filter navigation items to exclude disabled series
const filteredRouters = filterNavItems(routers, configuredSeriesSlugs, enabledSeriesSlugs, RESERVED_ROUTES);
const strippedPath = stripLocaleFromPath(Astro.url.pathname).replace(/\/$/, '') || '/';
const activeRoute = (path?: string) =>
  !!path && (strippedPath === path || (path !== '/' && strippedPath.startsWith(`${path}/`)));
// Group the configured navigation, preserving enabled routes and their translated labels.
const collectionPaths = ['/music', '/bangumi', '/hpoi', '/image-style-prompt-gallery'];
const connectionPaths = ['/friends', '/about'];
const sections = [
  {
    key: 'reading',
    label: t(locale, 'homeInfo.reading'),
    items: filteredRouters.filter((item) => ![...collectionPaths, ...connectionPaths].includes(item.path ?? '')),
  },
  {
    key: 'collections',
    label: t(locale, 'homeInfo.collections'),
    items: collectionPaths.flatMap((path) => filteredRouters.filter((item) => item.path === path)),
  },
  {
    key: 'connections',
    label: t(locale, 'homeInfo.connections'),
    items: filteredRouters.filter((item) => connectionPaths.includes(item.path ?? '')),
  },
];
---

<div class={cn('sidebar-cabinet', className)} data-home-info-container={uniqueId}>
  <div class="sidebar-profile-wrap">
    <SiteProfileView initial={profile} client:load />
    {christmasConfig.enabled && christmasConfig.features.christmasHat && (
      <div class="sidebar-hat pointer-events-none absolute top-0"><ChristmasHat /></div>
    )}
  </div>
  <div class="sidebar-stats">
    <a href={localizedPath('/', locale)}><strong>{postCount}</strong><span>{t(locale, 'homeInfo.articles')}</span></a>
    <a href={localizedPath('/categories', locale)}><strong>{Object.keys(countMap).length}</strong><span>{t(locale, 'homeInfo.categories')}</span></a>
    <a href={localizedPath('/tags', locale)}><strong>{allTags.length}</strong><span>{t(locale, 'homeInfo.tags')}</span></a>
  </div>
  <nav class="sidebar-navigation" aria-label={t(locale, 'drawer.navMenu')}>
    {sections.filter(section => section.items.length).map(section => (
      <section class="sidebar-nav-section" data-sidebar-section={section.key} aria-labelledby={`${uniqueId}-${section.key}`}>
        <h2 id={`${uniqueId}-${section.key}`} class="sidebar-section-label">{section.label}</h2>
        {section.items.map((item, index) => {
          const displayName = resolveNavName(item.nameKey, item.name, locale);
          if (item.children?.length) {
            const collapseId = `${uniqueId}-${section.key}-collapse-${index}`;
            const active = item.children.some(child => activeRoute(child.path));
            return (
              <div class="sidebar-nav-group" data-collapsible>
                <button class="sidebar-nav-link" data-collapse-trigger={collapseId} aria-expanded={active ? 'true' : 'false'} aria-controls={collapseId} aria-label={t(locale, 'common.menuLabel', { name: displayName })} type="button">
                  {item.icon && <Icon name={item.icon} class="sidebar-nav-icon" />}
                  <span>{displayName}</span>
                  <Icon name="ri:arrow-down-s-line" class="sidebar-nav-chevron" style={active ? 'transform:rotate(180deg)' : undefined} data-collapse-icon={collapseId} />
                </button>
                <div id={collapseId} inert={!active} class:list={{ 'collapse-hidden': !active }} data-collapse-content={collapseId}>
                  <div class="sidebar-nav-children">
                    {item.children.map(child => (
                      <a class="sidebar-nav-link" href={child.path ? localizedPath(child.path, locale) : undefined} aria-current={activeRoute(child.path) ? 'page' : undefined}>
                        {child.icon && <Icon name={child.icon} class="sidebar-nav-icon" />}
                        <span>{resolveNavName(child.nameKey, child.name, locale)}</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }
          return (
            <a class="sidebar-nav-link" href={item.path ? localizedPath(item.path, locale) : undefined} aria-current={activeRoute(item.path) ? 'page' : undefined}>
              {item.icon && <Icon name={item.icon} class="sidebar-nav-icon" />}
              <span>{displayName}</span>
              <span class="sidebar-active-dot" aria-hidden="true" />
            </a>
          );
        })}
      </section>
    ))}
  </nav>
</div>

<style>
  /* 折叠动画使用 CSS Grid 技巧实现平滑的高度过渡 */
  [data-collapse-content] {
    display: grid;
    grid-template-rows: 1fr;
  }

  [data-collapse-content] > div {
    min-height: 0;
    overflow: hidden;
  }

  [data-collapse-content].collapse-hidden {
    grid-template-rows: 0fr;
  }

  /* 只在用户未设置 reduce-motion 时应用动画 */
  @media (prefers-reduced-motion: no-preference) {
    [data-collapse-content] {
      transition: grid-template-rows 0.3s ease;
    }
  }
</style>
<script>
  // This Astro module runs once. Delegation also covers delayed mobile drawers
  // and swapped pages, without rescanning the document for every gallery append.
  document.addEventListener('click', (event) => {
    const trigger = event.target instanceof Element
      ? event.target.closest<HTMLElement>('button[data-collapse-trigger]')
      : null;
    const container = trigger?.closest('[data-home-info-container]');
    const targetId = trigger?.dataset.collapseTrigger;
    if (!trigger || !container || !targetId) return;
    // Drawers can contain another copy of the sidebar; resolve within its owner.
    const content = container.querySelector<HTMLElement>(`[data-collapse-content="${CSS.escape(targetId)}"]`);
    const icon = trigger.querySelector<HTMLElement>('[data-collapse-icon]');
    if (!content || !icon) return;
    event.preventDefault();
    event.stopPropagation();
    const expanded = trigger.getAttribute('aria-expanded') !== 'true';
    content.classList.toggle('collapse-hidden', !expanded);
    content.inert = !expanded;
    icon.style.transform = expanded ? 'rotate(180deg)' : 'rotate(0deg)';
    trigger.setAttribute('aria-expanded', String(expanded));
  });
</script>
