---
import HomeSider from '@components/layout/HomeSider.astro';
import StyleGalleryExamples from '@components/style-gallery/StyleGalleryExamples';
import StyleGalleryReferenceImages from '@components/style-gallery/StyleGalleryReferenceImages';
import StyleGalleryStorageHints from '@components/style-gallery/StyleGalleryStorageHints.astro';
import StylePromptCopy from '@components/style-gallery/StylePromptCopy';
import Cover from '@components/ui/cover/Cover.astro';
import { CONTENT_PADDING } from '@constants/layout';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { displayDate } from '@lib/date';
import { getStyleGalleryItemBySlug } from '@lib/style-gallery';
import { Icon } from 'astro-icon/components';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';

export const prerender = false;

const { slug } = Astro.params;
const locale = getLocaleFromUrl(Astro.url.pathname);
const item = slug ? await getStyleGalleryItemBySlug(slug) : undefined;
if (!item) return Astro.redirect(localizedPath('/image-style-prompt-gallery', locale), 302);

const data = item;
const title = `${data.title} | ${t(locale, 'gallery.title')} | ${siteConfig.title}`;
const description = data.prompt.slice(0, 140);
const galleryPath = localizedPath('/image-style-prompt-gallery', locale);
const referenceImages = data.images?.length
  ? data.images
  : [
      {
        sourceImage: data.sourceImage,
        thumbnailImage: data.thumbnailImage,
        sourceImageAlt: data.sourceImageAlt,
        imageHash: data.imageHash,
      },
    ];
Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=300');
---

<Layout title={title} description={description}>
  <StyleGalleryStorageHints slot="head" />
  <TwoColumnLayout>
    <Cover slot="cover" title={data.title} />
    <HomeSider slot="sider" />
    <div class={`bg-gradient-start shadow-box tablet:shadow-none flex flex-col gap-6 overflow-clip ${CONTENT_PADDING.standard}`}>
      <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
        <Icon name="fa6-solid:house-chimney" class="size-4" />
        <a href={localizedPath('/', locale)} class="hover:text-rose-500">{t(locale, 'breadcrumb.home')}</a>
        <Icon name="ri:arrow-right-s-line" class="size-4 opacity-60" />
        <a href={galleryPath} data-astro-prefetch="false" class="hover:text-rose-500">{t(locale, 'gallery.title')}</a>
        <Icon name="ri:arrow-right-s-line" class="size-4 opacity-60" />
        <span class="line-clamp-1 text-gray-900 dark:text-white">{data.title}</span>
      </nav>

      <article class="grid grid-cols-2 items-start gap-6 lg:grid-cols-1" data-pagefind-body>
        <aside class="sticky top-6 self-start space-y-4 lg:static">
          <header class="space-y-3 px-1">
            <h1 class="whitespace-nowrap font-black text-2xl text-gray-950 lg:whitespace-normal dark:text-white">{data.title}</h1>
            <div class="flex flex-nowrap gap-1.5 lg:flex-wrap">
              {(data.modelTargets ?? []).map((target) => (
                <span class="whitespace-nowrap rounded-full bg-sky-50 px-2.5 py-1 text-xs font-bold text-sky-600 dark:bg-sky-950/50 dark:text-sky-200">{target}</span>
              ))}
            </div>
            {data.tags?.length ? (
              <div class="flex flex-wrap gap-2">
                {data.tags.map((tag) => (
                  <span class="rounded-full border border-rose-100 px-3 py-1 text-xs font-bold text-gray-500 dark:border-gray-800 dark:text-gray-300">#{tag}</span>
                ))}
              </div>
            ) : null}
          </header>

          <div class="rounded-lg border border-rose-100 bg-white p-3 shadow-sm dark:border-gray-800 dark:bg-gray-950">
            <StyleGalleryReferenceImages
              client:load
              images={referenceImages}
              itemSlug={data.slug}
              prompt={data.prompt}
              promptCount={data.prompts.length}
              promptRevision={data.promptRevision}
              openImageLabel={t(locale, 'image.openLightbox')}
              referenceImageLabel={t(locale, 'gallery.referenceImage', { index: '{index}' })}
              lightboxCopyLabels={{
                copyPrompt: t(locale, 'image.copyPrompt'),
                copiedPrompt: t(locale, 'image.copiedPrompt'),
                copyFailed: t(locale, 'image.copyFailed'),
              }}
            />
          </div>
          <div class="grid grid-cols-2 gap-3 md:grid-cols-1">
            <div class="rounded-lg border border-rose-100 bg-white p-4 dark:border-gray-800 dark:bg-gray-950">
              <p class="text-xs font-bold uppercase tracking-wider text-gray-400">{t(locale, 'gallery.importedAt')}</p>
              <p class="mt-1 font-bold text-gray-900 dark:text-white">{displayDate.date(new Date(data.date))}</p>
            </div>
            <div class="rounded-lg border border-rose-100 bg-white p-4 dark:border-gray-800 dark:bg-gray-950">
              <p class="text-xs font-bold uppercase tracking-wider text-gray-400">{referenceImages.length > 1 ? 'GROUP SHA-256' : 'SHA-256'}</p>
              <p class="mt-1 truncate font-mono text-xs text-gray-700 dark:text-gray-300" title={data.imageHash}>{data.imageHash}</p>
            </div>
          </div>
        </aside>

        <section class="flex min-w-0 flex-col gap-5">
          <div>
            <StylePromptCopy
              client:load
              itemSlug={data.slug}
              prompts={data.prompts}
              label={t(locale, 'gallery.prompt')}
              copyLabel={t(locale, 'gallery.copy')}
              copiedLabel={t(locale, 'gallery.copied')}
              chooserLabel={t(locale, 'gallery.promptChooserTitle')}
              promptOptionLabel={t(locale, 'gallery.promptOption', { index: '{index}' })}
              unknownModelLabel={t(locale, 'gallery.promptModelUnknown')}
              originalPromptLabel={t(locale, 'gallery.originalPrompt')}
            />
          </div>
        </section>
      </article>

      <StyleGalleryExamples
        client:load
        slug={item.slug}
        title={data.title}
        prompt={data.prompt}
        promptCount={data.prompts.length}
        promptRevision={data.promptRevision}
        initialExamples={data.examples}
        uploadsEnabled={Boolean(process.env.STYLE_GALLERY_UPLOAD_TOKEN)}
        likeLabels={{
          like: t(locale, 'gallery.like'),
          unlike: t(locale, 'gallery.unlike'),
          loginRequired: t(locale, 'gallery.likeLoginRequired'),
          unavailable: t(locale, 'gallery.likeUnavailable'),
        }}
        lightboxActionLabels={{
          copyPrompt: t(locale, 'image.copyPrompt'),
          copiedPrompt: t(locale, 'image.copiedPrompt'),
          copyFailed: t(locale, 'image.copyFailed'),
          deleteImage: t(locale, 'image.deleteImage'),
          deletingImage: t(locale, 'image.deletingImage'),
          deleteFailed: t(locale, 'image.deleteFailed'),
          deleteRequiresToken: t(locale, 'image.deleteRequiresToken'),
          deleteConfirm: t(locale, 'image.deleteConfirm', { name: '{name}' }),
        }}
      />
    </div>
  </TwoColumnLayout>
</Layout>
