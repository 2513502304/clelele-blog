# -----------------------------------------------------------------------------
# 基础运行配置
# -----------------------------------------------------------------------------

# Docker 部署映射到宿主机的端口；普通 `pnpm dev --port ...` 不读取它，可按本机空闲端口修改。
BLOG_PORT=4321
# 构建时是否生成 Sonda bundle 分析报告。仅排查包体积时取消注释，日常构建保持关闭。
# ANALYZE=true

# -----------------------------------------------------------------------------
# About 页面随机动漫台词
# -----------------------------------------------------------------------------

# Yurippe API 使用的英文角色查询名。可先访问
# https://yurippe.vercel.app/api/quotes?character=<角色英文名> 验证是否存在数据。
# 同一角色的完整台词数组会在 Vercel warm instance 中缓存 30 天。
ANIME_QUOTE_CHARACTER="Yukino Yukinoshita"
# 页面署名使用的显示名称；只影响 UI，不参与 Yurippe 查询。为空时使用 API 返回的角色名。
ANIME_QUOTE_CHARACTER_LABEL="雪之下雪乃"

# -----------------------------------------------------------------------------
# Image Style Prompt Gallery 的 GitHub 登录
# -----------------------------------------------------------------------------
# 用途：为 Sub-gallery 点赞建立本站自己的 GitHub 会话，与 giscus iframe 登录相互独立。
# 获取方式：GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App。
# Production、Preview、Development 的 callback 若不同，应分别使用能够精确匹配 callback 的 OAuth App。

# GitHub OAuth App 页面显示的公开 Client ID，可暴露给浏览器。
STYLE_GALLERY_GITHUB_CLIENT_ID=
# GitHub OAuth App 生成的 Client Secret，只能配置在服务端/Vercel，不要提交真实值。
STYLE_GALLERY_GITHUB_CLIENT_SECRET=
# 必须与 OAuth App 的 Authorization callback URL 完全一致，例如：
# https://your-domain.example/api/style-gallery/auth/github/callback
STYLE_GALLERY_GITHUB_REDIRECT_URI=
# 用于签名 14 天登录 cookie 的本站独立密钥，不是 GitHub Secret，也不要与 Upload Token 复用。
# 至少 32 个字符；可运行 `openssl rand -base64 48` 生成。
STYLE_GALLERY_SESSION_SECRET=

# -----------------------------------------------------------------------------
# 网易云音乐服务端登录会话
# -----------------------------------------------------------------------------
# 用途：限定 `/music/admin` 与二维码/健康检查 API 的唯一管理员 GitHub 数字 ID。
# 获取方式：访问 `https://api.github.com/users/<GitHub 用户名>`，读取响应中的 `id` 字段。
# 注意：这里不能填写 GitHub 用户名，即使用户名本身完全由数字组成。
MUSIC_ADMIN_GITHUB_ID=129171955
# 用途：AES-256-GCM 加密扫码返回的网易云 Cookie；仅服务端使用，不是网易云 Cookie 本身。
# 获取方式：运行 `openssl rand -base64 48`。必须至少 32 个字符，丢失后需重新扫码建立会话。
MUSIC_SESSION_ENCRYPTION_KEY=
# 用途：加密会话对象在 HF Bucket 内的独立前缀。对象即使被读取也不包含明文 Cookie。
# Vercel Production/Preview 应共同使用 `private/music-session/production` 和同一加密密钥；
# 本地/Development 使用 `private/music-session/development` 与独立密钥，避免测试扫码覆盖线上会话。
MUSIC_SESSION_HF_S3_PREFIX=private/music-session/development
# 用途：登录音源为空、仅试听或请求失败时使用的既有 Meting API。
MUSIC_FALLBACK_METING_API=https://163.hyc.moe/
# 用途：请求网易云登录音源时使用的音质级别；常用值为 standard、exhigh、lossless。
# 最终可用音质仍取决于扫码账号的会员与歌曲版权权限。
MUSIC_NETEASE_AUDIO_LEVEL=exhigh
# 可选：健康检查除登录状态外，再验证一首确定有完整播放权限的网易云歌曲 ID。
# 不配置时健康检查只验证账号登录状态。
MUSIC_NETEASE_HEALTHCHECK_SONG_ID=

# -----------------------------------------------------------------------------
# Image Style Prompt Gallery 写入鉴权与 Hugging Face Bucket
# -----------------------------------------------------------------------------

# 保护上传、删除、平台修改、导入等 Gallery 写操作。它是本站自行生成的随机共享密钥，
# 不是 GitHub/HF Token；本地与 Vercel 必须配置相同值。可运行 `openssl rand -base64 48` 生成。
STYLE_GALLERY_UPLOAD_TOKEN=
# HF Bucket 的 S3 Access Key ID。获取方式：Hugging Face -> Settings -> Storage -> S3 credentials。
# 这对 S3 credentials 与普通 `HF_TOKEN` 不同；本地也可从 `aws --profile hf` 配置中导出。
HF_S3_ACCESS_KEY_ID=
# 与上一项配对的 HF Bucket S3 Secret Access Key，只能保存在 `.env.local` 或 Vercel Secret 中。
HF_S3_SECRET_ACCESS_KEY=
# HF S3 endpoint，末尾通常是账户/组织名。当前 bucket 所属账户为 clelele0722。
HF_S3_ENDPOINT=https://s3.hf.co/clelele0722
# HF Bucket 名称，对应 `hf://buckets/clelele0722/raw-datasets` 中的 `raw-datasets`。
HF_S3_BUCKET=raw-datasets
# Gallery 在 bucket 内使用的目录前缀；图片、item、catalog 与示例索引都位于该目录下。
STYLE_GALLERY_BUCKET_PREFIX=image-style-prompt-gallery
# 图片 GET 预签名 URL 的有效期，单位为秒；代码会限制在 1 秒到 7 天，86400 即 24 小时。
STYLE_GALLERY_SIGNED_URL_TTL_SECONDS=86400
# HF Bucket S3 签名区域。HF 当前示例和实际 bucket 均使用 us-east-1，不要跟随本机 AWS 默认区域。
HF_S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Live2D 模型发布与运行时只读回源
# -----------------------------------------------------------------------------
# 发布凭证只供本地维护脚本使用，需使用能够写入 bestdori 前缀的 HF S3 credentials。
LIVE2D_HF_S3_WRITE_ACCESS_KEY_ID=
LIVE2D_HF_S3_WRITE_SECRET_ACCESS_KEY=
# Vercel 回退路由使用另一对只读 credentials；不要复用上面的发布凭证。
LIVE2D_HF_S3_READ_ACCESS_KEY_ID=
LIVE2D_HF_S3_READ_SECRET_ACCESS_KEY=
# 以下位置配置同时用于发布脚本和只读回退；默认指向 clelele0722/raw-datasets/bestdori。
LIVE2D_HF_S3_ENDPOINT=https://s3.hf.co/clelele0722
LIVE2D_HF_S3_BUCKET=raw-datasets
LIVE2D_HF_S3_PREFIX=bestdori
LIVE2D_HF_S3_REGION=us-east-1
# 运行时资产回源开关：auto 跟随 site.yaml；enabled 用于功能开启前的 Preview 验证；disabled 可紧急停止全部回源。
LIVE2D_ASSET_DELIVERY_MODE=auto

# -----------------------------------------------------------------------------
# 本地 Gallery 导入/上传脚本
# -----------------------------------------------------------------------------

# prepare/merge/catalog 等小型 metadata 请求的站点地址。图片字节由本地脚本直传 HF，
# 因此使用生产地址也不会产生图片大小级别的 Vercel Fast Origin Transfer；调试时可改为 localhost。
STYLE_GALLERY_API_BASE_URL=https://clelele-blog.vercel.app
# 以下四项只供 `npm run import:style-prompts` 使用；不配置时依次使用 30000、120000、3、5。
STYLE_GALLERY_IMPORT_REQUEST_TIMEOUT_MS=30000
STYLE_GALLERY_IMPORT_UPLOAD_TIMEOUT_MS=120000
STYLE_GALLERY_IMPORT_ATTEMPTS=3
STYLE_GALLERY_IMPORT_UPLOAD_CONCURRENCY=5
